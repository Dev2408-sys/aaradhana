NODE_ENV=production
PORT=4010

# Contabo PostgreSQL (create DB + user first — see docs/DEPLOY_CONTABO.md)
DATABASE_URL=postgresql://aaradhana_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/aaradhana?schema=public

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS_LONG!!!!
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS_LONG!!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public site origin(s), comma-separated if needed
CORS_ORIGIN=https://aaradhana.khodi.in
FRONTEND_URL=https://aaradhana.khodi.in

PUBLIC_REGISTRATION_STATUS=PENDING
LOG_LEVEL=info

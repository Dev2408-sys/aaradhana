# Local development (Docker Postgres on host port 5434 — see docker-compose.yml)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://kesariya:kesariya_dev@localhost:5434/kesariya?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_REGISTRATION_STATUS=PENDING
LOG_LEVEL=info

# Same WhatsApp Cloud API keys as Khodi Mart (.env.prod)
WHATSAPP_DEV_MODE=false
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Production Contabo template: see .env.production.example + docs/DEPLOY_CONTABO.md

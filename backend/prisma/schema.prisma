generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MASTER_SELLER
  SELLER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SellerActivationStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EventDayStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  ISSUED
  SOLD
  CANCELLED
  VOID
}

enum SellerSettlementStatus {
  PENDING
  PARTIAL
  PAID
  ADJUSTED
}

/// Customer payment against a sale (PENDING ≡ unpaid).
enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERPAID
  REFUNDED
}

enum LedgerEntryType {
  SALE_DEBIT
  PAYMENT_CREDIT
  ADJUSTMENT_DEBIT
  ADJUSTMENT_CREDIT
  REFUND_DEBIT
  REVERSAL_CREDIT
  REVERSAL_DEBIT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum FinancialRecordStatus {
  RECORDED
  REVERSED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

/// Customer ticket handoff lifecycle (admin WhatsApp send is manual).
enum TicketDeliveryStatus {
  AWAITING_APPROVAL
  AWAITING_PAYMENT
  READY_TO_SEND
  SENT
}

enum IncentiveStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum AssignmentAction {
  ASSIGN
  UNASSIGN
  REASSIGN
  RELEASE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  mobile       String     @unique
  email        String?    @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sellerProfile          SellerProfile?
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  recordedPayments         SellerPayment[]           @relation("PaymentRecordedBy")
  reversedSellerPayments   SellerPayment[]           @relation("SellerPaymentReversedBy")
  receivedCustomerPayments CustomerPayment[]         @relation("CustomerPaymentReceivedBy")
  reversedCustomerPayments CustomerPayment[]         @relation("CustomerPaymentReversedBy")
  ledgerEntriesCreated     SellerLedgerEntry[]       @relation("LedgerCreatedBy")
  performedAssignments     TicketAssignmentHistory[] @relation("AssignmentPerformedBy")
  salesApproved            Sale[]                    @relation("SaleApprovedBy")
  salesWhatsappSent        Sale[]                    @relation("SaleWhatsappSentBy")

  @@index([mobile])
  @@index([email])
  @@map("users")
}

model SellerProfile {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @unique @map("user_id") @db.Uuid
  sellerCode       String                  @unique @map("seller_code")
  parentSellerId   String?                 @map("parent_seller_id") @db.Uuid
  level            Int                     @default(0)
  city             String?
  area             String?
  instagramHandle  String?                 @map("instagram_handle")
  expectedSales    Int?                    @map("expected_sales")
  activationStatus SellerActivationStatus  @default(PENDING) @map("activation_status")
  joinedAt         DateTime                @default(now()) @map("joined_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  user                   User                      @relation(fields: [userId], references: [id])
  parentSeller           SellerProfile?            @relation("SellerHierarchy", fields: [parentSellerId], references: [id])
  childSellers           SellerProfile[]           @relation("SellerHierarchy")
  tickets                Ticket[]                  @relation("TicketSeller")
  sales                  Sale[]
  payments               SellerPayment[]
  ledgerEntries          SellerLedgerEntry[]
  incentives             SellerIncentive[]
  assignmentsFrom        TicketAssignmentHistory[] @relation("AssignmentFromSeller")
  assignmentsTo          TicketAssignmentHistory[] @relation("AssignmentToSeller")

  @@index([sellerCode])
  @@index([parentSellerId])
  @@index([activationStatus])
  @@index([city])
  @@map("seller_profiles")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  venue       String
  /// Full venue address (demo / ops display)
  address     String?
  gateOpening String?     @map("gate_opening")
  showStart   String?     @map("show_start")
  timezone    String      @default("Asia/Kolkata")
  dailyTarget Int         @default(1100) @map("daily_target")
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  ticketTypes      TicketType[]
  tickets          Ticket[]
  sales            Sale[]
  ticketSequences  TicketSequence[]
  eventDays        EventDay[]
  dayPrices        EventDayPrice[]
  paymentSettings  PaymentSettings?

  @@map("events")
}

/// Navratri festival nights (Day 1–10) — business day in Asia/Kolkata.
model EventDay {
  id         String         @id @default(uuid()) @db.Uuid
  eventId    String         @map("event_id") @db.Uuid
  dayNumber  Int            @map("day_number")
  /// Calendar date stored as UTC midnight for that Asia/Kolkata calendar day
  eventDate  DateTime       @map("event_date") @db.Date
  label      String
  status     EventDayStatus @default(UPCOMING)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  event Event           @relation(fields: [eventId], references: [id])
  sales Sale[]
  prices EventDayPrice[]

  @@unique([eventId, dayNumber])
  @@unique([eventId, eventDate])
  @@index([eventId, dayNumber])
  @@map("event_days")
}

/// Admin-managed day-wise seller allocation price (base) + customer sell floor/suggestion.
model EventDayPrice {
  id                    String   @id @default(uuid()) @db.Uuid
  eventId               String   @map("event_id") @db.Uuid
  eventDayId            String   @map("event_day_id") @db.Uuid
  ticketTypeId          String   @map("ticket_type_id") @db.Uuid
  dayNumber             Int      @map("day_number")
  /// What seller owes admin per ticket
  basePrice             Decimal  @map("base_price") @db.Decimal(12, 2)
  /// Optional floor for customer selling price
  minimumSellingPrice   Decimal? @map("minimum_selling_price") @db.Decimal(12, 2)
  /// Optional default shown to sellers
  suggestedSellingPrice Decimal? @map("suggested_selling_price") @db.Decimal(12, 2)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  event      Event      @relation(fields: [eventId], references: [id])
  eventDay   EventDay   @relation(fields: [eventDayId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([eventDayId, ticketTypeId])
  @@unique([eventId, dayNumber, ticketTypeId])
  @@index([eventId, dayNumber])
  @@map("event_day_prices")
}

/// Admin UPI / settlement instructions shown to sellers.
model PaymentSettings {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @unique @map("event_id") @db.Uuid
  upiId            String?  @map("upi_id")
  upiPayeeName     String?  @map("upi_payee_name")
  upiInstructions  String?  @map("upi_instructions")
  /// Optional uploaded QR image; otherwise QR is generated from UPI ID
  upiQrImageUrl    String?  @map("upi_qr_image_url")
  /// Seller support WhatsApp (digits with country code, e.g. 9198…)
  supportWhatsapp  String?  @map("support_whatsapp")
  /// Legacy flag — UTR is no longer required for sell flow (screenshot proof instead)
  requireUtrForUpi Boolean  @default(false) @map("require_utr_for_upi")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])

  @@map("payment_settings")
}

/// Idempotent demo dataset marker — prevents duplicate demo sales on re-seed.
model DemoSeedMeta {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  stats     Json?
  seededAt  DateTime @default(now()) @map("seeded_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("demo_seed_meta")
}

model TicketType {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  name          String
  code          String
  /// Prefix used in ticket numbers, e.g. G → KSR-G-000001
  numberPrefix  String   @default("X") @map("number_prefix")
  basePrice     Decimal  @map("base_price") @db.Decimal(12, 2)
  minimumPrice  Decimal? @map("minimum_price") @db.Decimal(12, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  event     Event           @relation(fields: [eventId], references: [id])
  tickets   Ticket[]
  sequences TicketSequence[]
  saleItems SaleItem[]
  dayPrices EventDayPrice[]

  @@unique([eventId, code])
  @@map("ticket_types")
}

/// Concurrency-safe ticket number counters (unlimited issuance).
model TicketSequence {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  ticketTypeId  String   @map("ticket_type_id") @db.Uuid
  currentNumber Int      @default(0) @map("current_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  event      Event      @relation(fields: [eventId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([eventId, ticketTypeId])
  @@index([ticketTypeId])
  @@map("ticket_sequences")
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  ticketNumber String       @unique @map("ticket_number")
  ticketTypeId String       @map("ticket_type_id") @db.Uuid
  eventId      String       @map("event_id") @db.Uuid
  zone         String?
  eventDate    DateTime?    @map("event_date")
  status       TicketStatus @default(ISSUED)
  /// Selling seller for sales-first issuance (not pre-assignment inventory).
  sellerId     String?      @map("seller_id") @db.Uuid
  customerId   String?      @map("customer_id") @db.Uuid
  saleId       String?      @map("sale_id") @db.Uuid
  issuedAt     DateTime?    @map("issued_at")
  soldAt       DateTime?    @map("sold_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  ticketType        TicketType                 @relation(fields: [ticketTypeId], references: [id])
  event             Event                      @relation(fields: [eventId], references: [id])
  seller            SellerProfile?             @relation("TicketSeller", fields: [sellerId], references: [id])
  customer          Customer?                  @relation(fields: [customerId], references: [id])
  sale              Sale?                      @relation(fields: [saleId], references: [id])
  saleItem          SaleItem?
  assignmentHistory TicketAssignmentHistory[]

  @@index([ticketNumber])
  @@index([status])
  @@index([sellerId])
  @@index([eventId, ticketTypeId])
  @@index([createdAt])
  @@map("tickets")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  mobile    String   @unique
  email     String?
  city      String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets  Ticket[]
  sales    Sale[]
  payments CustomerPayment[]

  @@index([mobile])
  @@index([name])
  @@map("customers")
}

model Sale {
  id               String                 @id @default(uuid()) @db.Uuid
  saleNumber       String                 @unique @map("sale_number")
  sellerId         String                 @map("seller_id") @db.Uuid
  customerId       String                 @map("customer_id") @db.Uuid
  eventId          String                 @map("event_id") @db.Uuid
  /// Navratri event night number: 1 = 11 Oct … 10 = 20 Oct 2026
  eventDay         Int?                   @map("event_day")
  eventDayId       String?                @map("event_day_id") @db.Uuid
  /// Demo/seed tag for safe identification (e.g. DEMO)
  dataSource       String?                @map("data_source")
  totalQuantity    Int                    @map("total_quantity")
  totalAmount      Decimal                @map("total_amount") @db.Decimal(12, 2)
  baseAmount       Decimal                @map("base_amount") @db.Decimal(12, 2)
  sellerProfit     Decimal                @map("seller_profit") @db.Decimal(12, 2)
  /// Customer payment status (separate from seller settlement)
  paymentStatus    PaymentStatus          @default(PENDING) @map("payment_status")
  /// Seller settlement toward admin base receivable
  settlementStatus SellerSettlementStatus @default(PENDING) @map("settlement_status")
  saleStatus       SaleStatus             @default(PENDING) @map("sale_status")
  /// Ticket delivery / WhatsApp handoff status
  deliveryStatus   TicketDeliveryStatus   @default(AWAITING_APPROVAL) @map("delivery_status")
  /// Legacy UTR field (optional; sell flow uses screenshot proof instead)
  adminPaymentUtr  String?                @map("admin_payment_utr")
  /// Payment screenshot URL (seller → admin UPI proof)
  adminPaymentProofUrl String?            @map("admin_payment_proof_url")
  approvedAt       DateTime?              @map("approved_at")
  approvedByUserId String?                @map("approved_by_user_id") @db.Uuid
  rejectedAt       DateTime?              @map("rejected_at")
  rejectedReason   String?                @map("rejected_reason")
  /// When tickets are transferred to customer after payment confirmation
  ticketsTransferredAt DateTime?          @map("tickets_transferred_at")
  whatsappSentAt       DateTime?          @map("whatsapp_sent_at")
  whatsappSentByUserId String?            @map("whatsapp_sent_by_user_id") @db.Uuid
  soldAt           DateTime               @default(now()) @map("sold_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  seller         SellerProfile      @relation(fields: [sellerId], references: [id])
  customer       Customer           @relation(fields: [customerId], references: [id])
  event          Event              @relation(fields: [eventId], references: [id])
  eventDayRef    EventDay?          @relation(fields: [eventDayId], references: [id])
  approvedBy     User?              @relation("SaleApprovedBy", fields: [approvedByUserId], references: [id])
  whatsappSentBy User?              @relation("SaleWhatsappSentBy", fields: [whatsappSentByUserId], references: [id])
  items          SaleItem[]
  tickets        Ticket[]
  incentives     SellerIncentive[]
  customerPayments CustomerPayment[]
  ledgerEntries  SellerLedgerEntry[]

  @@index([sellerId])
  @@index([customerId])
  @@index([createdAt])
  @@index([soldAt])
  @@index([eventDay])
  @@index([eventDayId])
  @@index([dataSource])
  @@index([settlementStatus])
  @@index([paymentStatus])
  @@index([saleStatus])
  @@index([deliveryStatus])
  @@index([adminPaymentUtr])
  @@index([adminPaymentProofUrl])
  @@index([eventId, saleStatus, eventDay])
  @@index([eventId, saleStatus, sellerId])
  @@map("sales")
}

model SaleItem {
  id           String  @id @default(uuid()) @db.Uuid
  saleId       String  @map("sale_id") @db.Uuid
  ticketId     String  @unique @map("ticket_id") @db.Uuid
  ticketTypeId String  @map("ticket_type_id") @db.Uuid
  sellingPrice Decimal @map("selling_price") @db.Decimal(12, 2)
  basePrice    Decimal @map("base_price") @db.Decimal(12, 2)
  sellerProfit Decimal @map("seller_profit") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  sale       Sale       @relation(fields: [saleId], references: [id])
  ticket     Ticket     @relation(fields: [ticketId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([saleId])
  @@index([ticketTypeId])
  @@index([ticketTypeId, saleId])
  @@map("sale_items")
}

/// Concurrency-safe sale number counter (KS-SALE-000001).
model SaleSequence {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique @default("SALE")
  currentNumber Int      @default(0) @map("current_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("sale_sequences")
}

enum NotificationType {
  SALE_CREATED
  NEW_SALE
  PAYMENT_RECEIVED
  PAYMENT_PENDING
  SELLER_PAYMENT_RECEIVED
  PAYMENT_REVERSED
  SELLER_JOINED
  SELLER_ACTIVATED
  SELLER_SUSPENDED
  TICKET_CANCELLED
  DAILY_TARGET
  TEAM_SALE
  SYSTEM_ALERT
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  recipientUserId String           @map("recipient_user_id") @db.Uuid
  type            NotificationType
  title           String
  message         String
  entityType      String?          @map("entity_type")
  entityId        String?          @map("entity_id")
  isRead          Boolean          @default(false) @map("is_read")
  createdAt       DateTime         @default(now()) @map("created_at")
  readAt          DateTime?        @map("read_at")

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SellerPayment {
  id                   String                @id @default(uuid()) @db.Uuid
  sellerId             String                @map("seller_id") @db.Uuid
  amount               Decimal               @db.Decimal(12, 2)
  paymentMethod        PaymentMethod         @map("payment_method")
  transactionReference String?               @map("transaction_reference")
  idempotencyKey       String?               @unique @map("idempotency_key")
  paymentDate          DateTime              @map("payment_date")
  notes                String?
  status               FinancialRecordStatus @default(RECORDED)
  recordedBy           String                @map("recorded_by") @db.Uuid
  reversedAt           DateTime?             @map("reversed_at")
  reversedByUserId     String?               @map("reversed_by_user_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  seller     SellerProfile       @relation(fields: [sellerId], references: [id])
  recorder   User                @relation("PaymentRecordedBy", fields: [recordedBy], references: [id])
  reversedBy User?               @relation("SellerPaymentReversedBy", fields: [reversedByUserId], references: [id])
  ledgerEntries SellerLedgerEntry[]

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod, transactionReference])
  @@map("seller_payments")
}

/// Append-only seller settlement ledger (admin base receivable track).
/// Convention: DEBIT increases seller→admin outstanding; CREDIT decreases it.
/// Outstanding = sum(DEBIT amounts) − sum(CREDIT amounts).
model SellerLedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  sellerId         String          @map("seller_id") @db.Uuid
  saleId           String?         @map("sale_id") @db.Uuid
  sellerPaymentId  String?         @map("seller_payment_id") @db.Uuid
  entryType        LedgerEntryType @map("entry_type")
  direction        LedgerDirection
  /// Always positive; sign comes from direction.
  amount           Decimal         @db.Decimal(12, 2)
  balanceAfter     Decimal?        @map("balance_after") @db.Decimal(12, 2)
  /// Idempotency key, e.g. SALE_DEBIT:{saleId}
  reference        String          @unique
  description      String
  metadata         Json?
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")

  seller        SellerProfile  @relation(fields: [sellerId], references: [id])
  sale          Sale?          @relation(fields: [saleId], references: [id])
  sellerPayment SellerPayment? @relation(fields: [sellerPaymentId], references: [id])
  createdBy     User           @relation("LedgerCreatedBy", fields: [createdByUserId], references: [id])

  @@index([sellerId, createdAt])
  @@index([saleId])
  @@index([sellerPaymentId])
  @@index([entryType])
  @@map("seller_ledger_entries")
}

model CustomerPayment {
  id               String                @id @default(uuid()) @db.Uuid
  customerId       String                @map("customer_id") @db.Uuid
  saleId           String                @map("sale_id") @db.Uuid
  amount           Decimal               @db.Decimal(12, 2)
  paymentMethod    PaymentMethod         @map("payment_method")
  paymentReference String?               @map("payment_reference")
  idempotencyKey   String?               @unique @map("idempotency_key")
  notes            String?
  status           FinancialRecordStatus @default(RECORDED)
  receivedByUserId String                @map("received_by_user_id") @db.Uuid
  reversedAt       DateTime?             @map("reversed_at")
  reversedByUserId String?               @map("reversed_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  customer   Customer @relation(fields: [customerId], references: [id])
  sale       Sale     @relation(fields: [saleId], references: [id])
  receivedBy User     @relation("CustomerPaymentReceivedBy", fields: [receivedByUserId], references: [id])
  reversedBy User?    @relation("CustomerPaymentReversedBy", fields: [reversedByUserId], references: [id])

  @@index([customerId])
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod, paymentReference])
  @@map("customer_payments")
}

model SellerIncentive {
  id            String          @id @default(uuid()) @db.Uuid
  sellerId      String          @map("seller_id") @db.Uuid
  saleId        String?         @map("sale_id") @db.Uuid
  incentiveType String          @map("incentive_type")
  amount        Decimal         @db.Decimal(12, 2)
  status        IncentiveStatus @default(PENDING)
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")

  seller SellerProfile @relation(fields: [sellerId], references: [id])
  sale   Sale?         @relation(fields: [saleId], references: [id])

  @@index([sellerId])
  @@map("seller_incentives")
}

model TicketAssignmentHistory {
  id           String           @id @default(uuid()) @db.Uuid
  ticketId     String           @map("ticket_id") @db.Uuid
  fromSellerId String?          @map("from_seller_id") @db.Uuid
  toSellerId   String?          @map("to_seller_id") @db.Uuid
  action       AssignmentAction
  performedBy  String           @map("performed_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  ticket       Ticket         @relation(fields: [ticketId], references: [id])
  fromSeller   SellerProfile? @relation("AssignmentFromSeller", fields: [fromSellerId], references: [id])
  toSeller     SellerProfile? @relation("AssignmentToSeller", fields: [toSellerId], references: [id])
  performer    User           @relation("AssignmentPerformedBy", fields: [performedBy], references: [id])

  @@index([ticketId])
  @@map("ticket_assignment_history")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
